# ---- Required: Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xbtkanxufngkqbtinthk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose. Needed for webhooks, integrations, workflows, billing activation, account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL used in email links, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- AI (server side). Choose one provider ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AI_PROVIDER=openai, OPENAI_API_KEY=, OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=claude-sonnet-5-5
# AI_DAILY_LIMIT=300

# ---- Billing ----
# Shared secret that Selar must send: https://YOUR_DOMAIN/api/selar/webhook?secret=THIS_VALUE
SELAR_WEBHOOK_SECRET=
# Comma separated emails with platform admin access (manual payment verification, AI without a plan)
ADMIN_EMAILS=
